# Missing Russian translations completed during the Visor parity audit
visor.options.gui.hotbar.hud_disabled.tooltip=Отключение стандартного хотбара в HUD (устаревшая настройка, не использовать)
visor.options.vr_body.height.button=Настройки роста...
visor.options.vr_body.height.mode=Режим роста
visor.options.vr_body.height.mode.tooltip=§bРежим роста§r\n\n§e•§r §eПо модели§r — высота глаз совпадает с уровнем глаз игровой модели, как в обычной игре\n§e•§r §eРеальный рост§r — игровая модель масштабируется под ваш реальный рост\n\n§cВнимание:§r VR-сервер может переопределить выбранный режим.
visor.options.vr_body.height.adjustment=Коррекция
visor.options.vr_body.height.adjustment.tooltip=§bКоррекция§r\n\nКак добиться нужной высоты игровой модели.\n§e•§r §eМасштаб мира§r — масштабирует мир\n§e•§r §eСмещение камеры§r — меняет положение точки обзора
visor.options.vr_body.height.units=Единицы
visor.options.vr_body.height.auto=Автоизмерение роста
visor.options.vr_body.height.auto.tooltip=§bАвтоизмерение роста§r\n\nАвтоматически измеряет ваш рост стоя. Выключите, чтобы настроить значение вручную.
visor.options.vr_body.height.standing=Ваш рост
visor.options.vr_body.height.standing.tooltip=§bВаш рост§r\n\nВаш реальный рост стоя. Изменяется только при выключенном автоизмерении.
visor.options.vr_body.height.measure.button=Измерить сейчас
visor.options.vr_body.height.title=Настройки роста
visor.options.vr_body.height.units.tooltip=§bЕдиницы§r\n\nПоказывать рост в сантиметрах или футах и дюймах.
visor.height.metric=%d см
visor.height.imperial=%d фт %d дюйм
visor.options.world.button=Мир
visor.options.world.note.editable=Настройки миров, которые вы открываете для других игроков
visor.options.world.note.readonly=Настройки текущего мира — изменить их можно в главном меню
visor.options.world.two_handed=Две руки
visor.options.world.two_handed.tooltip=§bИспользование обеих рук§r\n\nПозволяет использовать предметы обеими руками: взаимодействовать двумя контроллерами и назначать слот хотбара для второй руки.\n\n§7Настройка сервера: действует в мирах, которые открываете вы. На чужом сервере решение принимает сервер.§r
visor.options.world.better_swinging=Улучшенные взмахи
visor.options.world.better_swinging.tooltip=§bУлучшенные взмахи§r\n\nVR-обработка взмахов вместо стандартной логики: урон при каждом взмахе, независимая добыча блоков обеими руками.\n§cВыкл.§r — поведение ближе к обычной игре.\n\n§7Настройка сервера: действует в мирах, которые открываете вы. На чужом сервере решение принимает сервер.§r
visor.options.world.roomscale_shield=Щит с учётом положения рук
visor.options.world.roomscale_shield.tooltip=§bЩит с учётом положения рук§r\n\nБлокирует удары, которые приходят по поднятому щиту, даже без удержания кнопки использования.\n\n§7Настройка сервера: действует в мирах, которые открываете вы. На чужом сервере решение принимает сервер.§r
visor.options.world.attacks_while_blocking=Атака при блокировании
visor.options.world.attacks_while_blocking.tooltip=§bАтака при блокировании§r\n\nПозволяет атаковать взмахом, пока щит поднят.\n\n§7Настройка сервера: действует в мирах, которые открываете вы. На чужом сервере решение принимает сервер.§r
visor.options.world.room_crawling=Ползание
visor.options.world.room_crawling.tooltip=§bПоддержка ползания§r\n\nРазрешает ползать в этом мире. Игрок также должен включить ползание в настройках погружения.\n\n§7Настройка сервера: действует в мирах, которые открываете вы. На чужом сервере решение принимает сервер.§r
visor.options.world.room_climbing=Лазание
visor.options.world.room_climbing.tooltip=§bПоддержка лазания§r\n\nРазрешает карабкаться руками по лестницам и другим подходящим блокам. Игрок также должен включить лазание в настройках погружения.\n\n§7Настройка сервера: действует в мирах, которые открываете вы. На чужом сервере решение принимает сервер.§r
visor.options.world.supported_movement=Разрешённое перемещение
visor.options.world.supported_movement.tooltip=§bРазрешённое перемещение§r\n\n§e•§r §eКонтроллер§r — только перемещение стиком\n§e•§r §eТелепортация§r — только телепортация\n§e•§r §eОба варианта§r — игрок выбирает в настройках перемещения\n\n§7Настройка сервера: на сервере окончательное решение принимает сервер.§r
visor.options.world.supported_height_mode=Разрешённый режим роста
visor.options.world.supported_height_mode.tooltip=§bРазрешённый режим роста§r\n\n§e•§r §eПо модели§r — модель сохраняет обычный масштаб, изменяется положение обзора\n§e•§r §eРеальный рост§r — модель масштабируется под рост игрока в VR\n§e•§r §eОба варианта§r — игрок выбирает в настройках тела\n\n§7Настройка сервера: на сервере окончательное решение принимает сервер.§r
